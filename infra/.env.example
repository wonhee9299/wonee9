# 이 파일을 .env 로 복사한 뒤 값을 채우세요.   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 저장소에 올라가지 않습니다.

# ── 기본 ───────────────────────────────────────────────────────────────
TZ=Asia/Seoul

# 컨테이너 데이터가 실제로 저장될 NAS 경로.
# 시놀로지에서는 보통 /volume1/docker 를 씁니다. File Station 에서 먼저
# 'docker' 공유 폴더가 있는지 확인하세요.
DOCKER_ROOT=/volume1/docker

# ── 접속 주소 ──────────────────────────────────────────────────────────
# 서비스에 붙일 이름. status.nas.local 처럼 앞에 서비스 이름이 붙습니다.
BASE_DOMAIN=nas.local

# http = 내부망 전용(인증서 없음, 설정이 가장 단순)
# https = 진짜 도메인이 있을 때. ACME_EMAIL 도 채워야 합니다.
SITE_SCHEME=http

# SITE_SCHEME=https 일 때만 사용. 인증서 만료 알림을 받을 주소입니다.
ACME_EMAIL=

# DSM 이 5000/5001 을, Web Station 이 80/443 을 이미 쓰고 있을 수 있어
# 겹치지 않는 포트를 기본값으로 둡니다.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# ── 데이터베이스 (data 프로필을 쓸 때만) ───────────────────────────────
POSTGRES_USER=app
POSTGRES_DB=app
# 반드시 직접 만든 값으로 바꾸세요. 아래 명령으로 만들 수 있습니다:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# ── 원격 접속 (remote 프로필을 쓸 때만) ────────────────────────────────
# https://login.tailscale.com/admin/settings/keys 에서 발급합니다.
TS_AUTHKEY=
TS_HOSTNAME=wonee9-nas
TS_EXTRA_ARGS=--accept-dns=false

# ── 백업 ───────────────────────────────────────────────────────────────
# 백업 파일을 둘 NAS 경로. DOCKER_ROOT 와 다른 볼륨이면 더 안전합니다.
BACKUP_ROOT=/volume1/backup/infra
# 보관할 백업 개수. 이보다 오래된 것은 자동으로 지웁니다.
BACKUP_KEEP=14
