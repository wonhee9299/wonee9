# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 저장소에 올라가지 않습니다.

# ── 필수 ───────────────────────────────────────────────────────────────
# NAS 주소. 내부망이면 사설 IP, 외부 접속이면 DDNS 주소를 씁니다.
#   HTTP  기본 포트 5000 / HTTPS 기본 포트 5001
SYNOLOGY_URL=http://192.168.0.10:5000

# DSM 계정. File Station 접근 권한이 있어야 합니다.
SYNOLOGY_USER=your-dsm-account
SYNOLOGY_PASS=your-dsm-password

# ── 선택 ───────────────────────────────────────────────────────────────
# 2단계 인증을 켜 두었다면 OTP 6자리. 코드가 30초마다 바뀌므로
# 여기에 적어두기보다 실행할 때마다 넘기는 편이 낫습니다:
#   SYNOLOGY_OTP=123456 ./nas snapshot
#SYNOLOGY_OTP=

# 작업을 저장할 NAS 기준 경로. 반드시 공유 폴더로 시작해야 합니다.
#   예) /home/work  (개인 홈 폴더 안)
#       /volume1/work  (공유 폴더)
NAS_BASE_PATH=/home/work

# 자체 서명 인증서(DSM 기본값)로 HTTPS 를 쓸 때만 false 로 두세요.
# 외부망에서는 정식 인증서를 발급받아 true 로 유지하는 편이 안전합니다.
SYNOLOGY_VERIFY_SSL=true

# 네트워크 응답 대기 시간(초). 대용량 업로드가 잦으면 늘리세요.
SYNOLOGY_TIMEOUT=60
